# Hosted Supabase project. Copy to .env.hosted (gitignored) and fill in the values.
# Run with: npm run dev:hosted  (or npm run build:hosted).
# The URL is the project URL from Dashboard -> Project Settings -> API.
# The anon key is the public anon key; it is safe in the browser, but still never commit it.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=
VITE_MODEL=deepseek/deepseek-v4.1-flash
VITE_FALLBACK_MODEL=
VITE_CONCURRENCY=3
